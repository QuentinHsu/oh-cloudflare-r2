{
  "name": "nuxthub-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "deploy-cloudflare": "NITRO_PRESET=cloudflare_module pnpm build && wrangler deploy",
    "postinstall": "nuxt prepare",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test --run && NITRO_PRESET=cloudflare_module pnpm build",
    "test": "vitest",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.4.1",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nuxt": "^4.4.8",
    "nuxt-auth-utils": "^0.5.29",
    "reka-ui": "^2.10.1",
    "shadcn-nuxt": "^2.8.0",
    "tailwind-merge": "^3.6.0",
    "vue-i18n": "^11.4.6",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260716.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "tailwindcss": "^4.3.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7",
    "wrangler": "4.111.0"
  },
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  }
}

# GitHub OAuth
# 在 https://github.com/settings/developers 创建 OAuth App
# Authorization callback URL: http://localhost:3000/api/auth/github
NUXT_OAUTH_GITHUB_CLIENT_ID=your_github_client_id
NUXT_OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret

# 允许登录的 GitHub 数字 User ID（逗号分隔）
# 未配置、留空或包含非数字值时将拒绝所有用户
NUXT_ALLOWED_GITHUB_USER_IDS=12345678,87654321

# Session 密钥 (可以用 openssl rand -base64 32 生成)
NUXT_SESSION_PASSWORD=your_session_password_at_least_32_characters

# 允许加载资源的域名（逗号分隔）
# 支持通配符子域名，如 *.example.com
# 留空则不限制
NUXT_ALLOWED_ORIGINS=https://example.com,https://app.example.com
